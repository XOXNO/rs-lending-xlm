# The codebase-memory-mcp graph in .codebase-memory/ is tracked, so CI and
# other clones load the code graph without a full reindex.
# .codebase-memory/.gitattributes marks graph.db.zst as `binary merge=ours`,
# which requires `git config merge.ours.driver true`.
