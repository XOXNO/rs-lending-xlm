  have hp := IScalar.tryMkOpt_eq .I128 x
  simp only [math.fp_core.rescale_ceil.closure.Insts.CoreOpsFunctionFnPairI128OptionI128I128.call]
  cases hpo : IScalar.tryMkOpt .I128 x with
