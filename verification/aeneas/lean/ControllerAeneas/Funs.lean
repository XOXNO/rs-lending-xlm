def positions.liquidation.curve.liquidation_at_target
  (env : aeneas_soroban_shim.Env)
  (snap : positions.liquidation.curve.LiquidationSnapshot)
  (bonus : math.fp.Bps) (target_hf : math.fp.Wad) :
  Result math.fp.Wad
  := do
  let w ← math.fp.Bps.to_wad bonus env
  let one_plus_bonus ← math.fp.Wad.checked_add math.fp.Wad.ONE env w
  let d_max ← math.fp.Wad.div snap.total_collateral env one_plus_bonus
  let denom_term ← math.fp.Wad.mul snap.proportion_seized env one_plus_bonus
  let target_debt ← math.fp.Wad.mul target_hf env snap.total_debt
  let b ←
    core.cmp.PartialOrd.le.trait_default math.fp.Wad.Insts.CoreCmpPartialOrdWad
      target_hf denom_term
  if b
  then
    core.cmp.Ord.min.trait_default math.fp.Wad.Insts.CoreCmpOrd d_max
      snap.total_debt
  else
    let b1 ←
      core.cmp.PartialOrd.le.trait_default
        math.fp.Wad.Insts.CoreCmpPartialOrdWad target_debt
        snap.weighted_collateral
    if b1
    then
      core.cmp.Ord.min.trait_default math.fp.Wad.Insts.CoreCmpOrd d_max
        snap.total_debt
    else
      let numerator ←
        math.fp.Wad.checked_sub target_debt env snap.weighted_collateral
      let denominator ← math.fp.Wad.checked_sub target_hf env denom_term
      let w1 ← math.fp.Wad.div numerator env denominator
      let w2 ←
        core.cmp.Ord.min.trait_default math.fp.Wad.Insts.CoreCmpOrd w1 d_max
      core.cmp.Ord.min.trait_default math.fp.Wad.Insts.CoreCmpOrd w2
        snap.total_debt

