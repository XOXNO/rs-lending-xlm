  (supply_positions : aeneas_soroban_shim.Map types.HubAssetKey
  types.AccountPositionRaw)
  (borrow_positions : aeneas_soroban_shim.Map types.HubAssetKey
  types.DebtPositionRaw) :
  Result (risk.totals.AccountRiskTotals × context.Context)
  := do
  let v ← aeneas_soroban_shim.Map.keys supply_positions
  let v1 ← aeneas_soroban_shim.Map.keys borrow_positions
  let v2 ← risk.totals.portfolio_hub_keys v v1
  let cache1 ← context.Context.load_markets cache v2
  let iter ← storage.iter_typed_positions supply_positions
  let (cache2, total_collateral, ltv_collateral, weighted_collateral) ←
    risk.totals.calculate_account_risk_totals_body_loop iter env cache1
      math.fp.Wad.ZERO math.fp.Wad.ZERO math.fp.Wad.ZERO
  let (total_debt, cache3) ←
    risk.totals.sum_debt_usd_loaded env cache2 borrow_positions
      risk.totals.DebtValue.Ceil
  let b ←
    math.fp.Wad.Insts.CoreCmpPartialEqWad.eq total_debt math.fp.Wad.ZERO
  if b
  then
    let health_factor ←
      math.fp.Wad.from (core.convert.IntoFrom (core.convert.FromSame Std.I128))
        core.num.I128.MAX
    ok
      ({
         total_collateral,
         ltv_collateral,
         weighted_collateral,
         total_debt,
         health_factor
       }, cache3)
  else
    let health_factor ←
      math.fp.Wad.div_floor_saturating weighted_collateral env total_debt
    ok
      ({
         total_collateral,
         ltv_collateral,
         weighted_collateral,
         total_debt,
         health_factor
       }, cache3)

/-- [controller_aeneas::risk::totals::calculate_account_risk_totals]:
    Source: 'src/risk/totals.rs', lines 128:0-135:1 -/
def risk.totals.calculate_account_risk_totals
  (env : aeneas_soroban_shim.Env) (cache : context.Context)
  (supply_positions : aeneas_soroban_shim.Map types.HubAssetKey
  types.AccountPositionRaw)
  (borrow_positions : aeneas_soroban_shim.Map types.HubAssetKey
  types.DebtPositionRaw) :
  Result (risk.totals.AccountRiskTotals × context.Context)
  := do
  risk.totals.calculate_account_risk_totals_body env cache supply_positions
    borrow_positions

end controller_aeneas
