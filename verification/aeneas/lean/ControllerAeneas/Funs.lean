    context.Context)
  := do
  let refunds ← aeneas_soroban_shim.Vec.new types.PaymentTuple env
  let ((total_debt_payment_usd, repaid_tokens), refunds1, cache1) ←
    positions.liquidation.math.calculate_repayment_amounts env raw_payments
      account refunds cache
  let (curve_repayment_usd, bonus) ←
    positions.liquidation.curve.estimate_liquidation_amount env snap
      bonus_bounds curve
  let insolvent ←
    core.cmp.PartialOrd.lt.trait_default math.fp.Wad.Insts.CoreCmpPartialOrdWad
      snap.total_collateral snap.total_debt
  let (cache2, refunds2, ideal_repayment_usd) ←
    if insolvent
    then ok (cache1, refunds1, curve_repayment_usd)
    else
      do
      let b ←
        core.cmp.PartialOrd.ge.trait_default
          math.fp.Wad.Insts.CoreCmpPartialOrdWad curve_repayment_usd
          snap.total_debt
      let (c, w) ←
        if b
        then ok (cache1, curve_repayment_usd)
        else
          do
          let (ideal_repayment_usd1, cache3) ←
            positions.liquidation.math.whole_unit_repayment env account snap
              curve_repayment_usd bonus cache1
          ok (cache3, ideal_repayment_usd1)
      ok (c, refunds1, w)
  let full_close ←
    core.cmp.PartialOrd.ge.trait_default math.fp.Wad.Insts.CoreCmpPartialOrdWad
      ideal_repayment_usd snap.total_debt
  let (refunds3, final_repayment_tokens) ←
    if full_close
    then ok (refunds2, repaid_tokens)
    else
      do
      let b ←
        core.cmp.PartialOrd.gt.trait_default
          math.fp.Wad.Insts.CoreCmpPartialOrdWad total_debt_payment_usd
          ideal_repayment_usd
      if b
      then
        let excess_usd ←
          math.fp.Wad.checked_sub total_debt_payment_usd env
            ideal_repayment_usd
        let (repaid_tokens1, refunds4) ←
          positions.liquidation.math.process_excess_payment env repaid_tokens
            refunds2 excess_usd insolvent
        ok (refunds4, repaid_tokens1)
      else ok (refunds2, repaid_tokens)
  let repay_usd ←
    positions.liquidation.math.sum_repaid_usd env final_repayment_tokens
  let seize_all ←
    if insolvent
    then
      do
      let b ←
        core.cmp.PartialOrd.gt.trait_default
          math.fp.Wad.Insts.CoreCmpPartialOrdWad repay_usd math.fp.Wad.ZERO
      if b
      then
        let w ←
          positions.liquidation.math.one_unit_per_leg_usd env
            final_repayment_tokens
        let w1 ← math.fp.Wad.checked_add repay_usd env w
        core.cmp.PartialOrd.ge.trait_default
          math.fp.Wad.Insts.CoreCmpPartialOrdWad w1 ideal_repayment_usd
      else ok false
    else ok false
  if full_close
  then
    let (repays_all_debt, cache3) ←
      positions.liquidation.math.repays_every_debt_leg env account
        final_repayment_tokens cache2
    ok
      ({
         repaid := final_repayment_tokens,
         refunds := refunds3,
         repay_usd,
         bonus,
         full_close,
         repays_all_debt,
         seize_all
       }, cache3)
  else
    ok
      ({
         repaid := final_repayment_tokens,
         refunds := refunds3,
         repay_usd,
         bonus,
         full_close,
         repays_all_debt := false,
         seize_all
       }, cache2)

