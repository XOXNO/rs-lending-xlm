def positions.liquidation.math.whole_unit_repayment
  (env : aeneas_soroban_shim.Env) (account : types.Account)
  (snap : positions.liquidation.curve.LiquidationSnapshot)
  (quote_usd : math.fp.Wad) (bonus : math.fp.Bps) (cache : context.Context) :
  Result (math.fp.Wad × context.Context)
  := do
  let i ← aeneas_soroban_shim.Map.len account.supply_positions
  if i != 1#u32
  then ok (quote_usd, cache)
  else
    let vi ← storage.iter_typed_positions account.supply_positions
    let (o, _) ←
      aeneas_soroban_shim.VecIter.Insts.CoreIterTraitsIteratorIterator.next vi
    match o with
    | none => ok (quote_usd, cache)
    | some p =>
      let (hub_asset, position) := p
      let (feed, cache1) ← context.Context.cached_price cache hub_asset.asset
      if feed.asset_decimals >=
        constants.production.shared.MIN_BORROWABLE_ASSET_DECIMALS
      then ok (quote_usd, cache1)
      else
        let (mi, cache2) ←
          context.Context.cached_market_index cache1 hub_asset
        let r ← math.fp.Ray.mul position.scaled_amount env mi.supply_index
        let held_units ← math.fp.Ray.to_asset_floor r env feed.asset_decimals
        if held_units < 1#i128
        then ok (quote_usd, cache2)
        else
          let w ← math.fp.Bps.to_wad bonus env
          let one_plus_bonus ← math.fp.Wad.checked_add math.fp.Wad.ONE env w
          let w1 ← math.fp.Wad.from_token env 1#i128 feed.asset_decimals
          let unit_usd ← math.fp.Wad.mul w1 env feed.price
          let i1 ← math.fp.Wad.raw unit_usd
          let i2 ← i1 / 1000000#i128
          let i3 ← lift (core.cmp.impls.OrdI128.max i2 1#i128)
          let w2 ←
            math.fp.Wad.from (core.convert.IntoFrom (core.convert.FromSame
              Std.I128)) i3
          let unit_with_margin ← math.fp.Wad.checked_add unit_usd env w2
          let w3 ← math.fp.Wad.mul quote_usd env one_plus_bonus
          let b ←
            core.cmp.PartialOrd.ge.trait_default
              math.fp.Wad.Insts.CoreCmpPartialOrdWad w3 unit_with_margin
          if b
          then ok (quote_usd, cache2)
          else
            let unit_at_bonus ←
              math.fp.Wad.div_floor unit_usd env one_plus_bonus
            let (w4, cache3) ←
              positions.liquidation.math.one_unit_per_debt_leg_usd env account
                cache2
            let full_close_ceiling ←
              math.fp.Wad.checked_add snap.total_debt env w4
            let b1 ←
              core.cmp.PartialOrd.ge.trait_default
                math.fp.Wad.Insts.CoreCmpPartialOrdWad unit_at_bonus
                full_close_ceiling
            if b1
            then ok (snap.total_debt, cache3)
            else
              let unit_repayment ←
                math.fp.Wad.div_ceil unit_with_margin env one_plus_bonus
              let b2 ←
                core.cmp.PartialOrd.ge.trait_default
                  math.fp.Wad.Insts.CoreCmpPartialOrdWad unit_repayment
                  snap.total_debt
              if b2
              then ok (quote_usd, cache3)
              else ok (unit_repayment, cache3)

