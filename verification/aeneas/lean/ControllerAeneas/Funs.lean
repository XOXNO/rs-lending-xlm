def context.Context.cached_market_index
  (self : context.Context) (hub_asset : types.HubAssetKey) :
  Result (types.MarketIndex × context.Context)
  := do
  let hak ← types.HubAssetKey.Insts.CoreCloneClone.clone hub_asset
  let o ← aeneas_soroban_shim.Map.get self.market_indexes hak
  match o with
  | none =>
    let index ← external.fetch_market_index self.env hub_asset
    let mir ← types.MarketIndexRaw.Insts.CoreCloneClone.clone index
    let m ← aeneas_soroban_shim.Map.set self.market_indexes hak mir
    let mi ←
      core.convert.IntoFrom.into
        types.MarketIndex.Insts.CoreConvertFromShared0MarketIndexRaw index
    ok (mi, { self with market_indexes := m })
  | some index =>
    let mi ←
      core.convert.IntoFrom.into
        types.MarketIndex.Insts.CoreConvertFromShared0MarketIndexRaw index
    ok (mi, self)

