def math.fp_core.div_floor_i128
  (p : Std.I128) (d : Std.I128) : Result (Option Std.I128) := do
  let o ← lift (I128.checked_div p d)
  let cf ← core.option.Option.Insts.CoreOpsTry_traitTry.branch o
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val =>
    let i ← p % d
    if i != 0#i128
    then
      if (p < 0#i128) != (d < 0#i128)
      then ok (I128.checked_sub val 1#i128)
      else ok (some val)
    else ok (some val)
  | core.ops.control_flow.ControlFlow.Break residual =>
    core.option.Option.Insts.CoreOpsTry_traitFromResidualOptionNever.from_residual
      Std.I128 residual

