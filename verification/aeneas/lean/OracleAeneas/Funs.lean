def oracle.lp_stable.fair_stable_lp_price_wad
  (env : aeneas_oracle_shim.Env) (a : oracle.lp.LpLeg) (b : oracle.lp.LpLeg)
  (supply : oracle.lp.LpSupply) (amp : Std.U128) :
