def math.fp_core.div_floor_i256
  (env : aeneas_oracle_shim.Env) (p : aeneas_oracle_shim.I256)
  (d : aeneas_oracle_shim.I256) (nonneg : Bool) :
  Result aeneas_oracle_shim.I256
  := do
  if nonneg
  then aeneas_oracle_shim.I256.div p d
  else
    let zero ← aeneas_oracle_shim.I256.from_i128 env 0#i128
    let quotient ← aeneas_oracle_shim.I256.div p d
    let i ← aeneas_oracle_shim.I256.rem_euclid p d
    let b ←
      core.cmp.PartialEq.ne.trait_default
        aeneas_oracle_shim.I256.Insts.CoreCmpPartialEqI256 i zero
    if b
    then
      let b1 ←
        core.cmp.PartialOrd.lt.trait_default
          aeneas_oracle_shim.I256.Insts.CoreCmpPartialOrdI256 p zero
      let b2 ←
        core.cmp.PartialOrd.lt.trait_default
          aeneas_oracle_shim.I256.Insts.CoreCmpPartialOrdI256 d zero
      if b1 != b2
      then
        let i1 ← aeneas_oracle_shim.I256.from_i128 env 1#i128
        aeneas_oracle_shim.I256.sub quotient i1
      else ok quotient
    else ok quotient

