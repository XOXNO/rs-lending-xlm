def oracle.lp_stable.solve_stable_d
  (env : aeneas_oracle_shim.Env) (xa_wad : Std.I128) (xb_wad : Std.I128)
  (amp : Std.U128) :
  Result (core.result.Result aeneas_oracle_shim.U256 errors.OracleError)
  := do
  if xa_wad <= 0#i128
  then ok (core.result.Result.Err errors.OracleError.InvalidPrice)
  else
    if xb_wad <= 0#i128
    then ok (core.result.Result.Err errors.OracleError.InvalidPrice)
    else
      let ri ←
        core.ops.range.RangeInclusive.new oracle.lp_stable.MIN_AMP
          oracle.lp_stable.MAX_AMP
      let b ←
        core.ops.range.RangeInclusive.contains core.cmp.PartialOrdU128
          core.cmp.PartialOrdU128 core.cmp.PartialOrdU128 ri amp
      if b
      then
        let i ← lift (IScalar.hcast .U128 xa_wad)
        let i1 ← oracle.lp_stable.MAX_NORMALIZED_RESERVE_WAD
        if i > i1
        then ok (core.result.Result.Err errors.OracleError.InvalidPrice)
        else
          let i2 ← lift (IScalar.hcast .U128 xb_wad)
          if i2 > i1
          then ok (core.result.Result.Err errors.OracleError.InvalidPrice)
          else
            let n ←
              aeneas_oracle_shim.U256.from_u32 env oracle.lp_stable.N_COINS
            let one ← aeneas_oracle_shim.U256.from_u32 env 1#u32
            let i3 ← lift (core.cmp.impls.OrdI128.min xa_wad xb_wad)
            let i4 ← lift (IScalar.hcast .U128 i3)
            let x_smaller ← aeneas_oracle_shim.U256.from_u128 env i4
            let i5 ← lift (core.cmp.impls.OrdI128.max xa_wad xb_wad)
            let i6 ← lift (IScalar.hcast .U128 i5)
            let x_larger ← aeneas_oracle_shim.U256.from_u128 env i6
            let sum ← aeneas_oracle_shim.U256.add x_smaller x_larger
            let u ← aeneas_oracle_shim.U256.from_u128 env amp
            let ann ← aeneas_oracle_shim.U256.mul u n
            let d ← aeneas_oracle_shim.U256.Insts.CoreCloneClone.clone sum
            oracle.lp_stable.solve_stable_d_loop
              { start := 0#u32, «end» := oracle.lp_stable.MAX_D_ITERATIONS }
              n one x_smaller x_larger sum ann d
      else ok (core.result.Result.Err errors.OracleError.InvalidPrice)

