def math.fp_core.div_by_int_half_up
  (env : aeneas_oracle_shim.Env) (a : Std.I128) (b : Std.I128) :
  Result Std.I128
  := do
  math.fp_core.require_nonzero_divisor env b
  massert (¬ (b < 0#i128))
  let quotient ← a / b
  let remainder ← a % b
  let i ← b / 2#i128
  let i1 ← b % 2#i128
  let half ← i + i1
