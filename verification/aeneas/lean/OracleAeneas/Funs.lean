  := do
  if a.reserve <= 0#i128
  then ok (core.result.Result.Err errors.OracleError.InvalidPrice)
  else
    if b.reserve <= 0#i128
    then ok (core.result.Result.Err errors.OracleError.InvalidPrice)
    else
      if a.price_wad <= 0#i128
      then ok (core.result.Result.Err errors.OracleError.InvalidPrice)
      else
        if b.price_wad <= 0#i128
        then ok (core.result.Result.Err errors.OracleError.InvalidPrice)
        else
          if supply.total_shares <= 0#i128
          then ok (core.result.Result.Err errors.OracleError.InvalidPrice)
          else
            let r ← oracle.observation.try_amount_to_wad a.reserve a.decimals
            let cf ← core.result.Result.Insts.CoreOpsTry.branch r
            match cf with
            | core.ops.control_flow.ControlFlow.Continue val =>
              let r1 ←
                oracle.observation.try_amount_to_wad b.reserve b.decimals
              let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
              match cf1 with
              | core.ops.control_flow.ControlFlow.Continue val1 =>
                let r2 ← oracle.lp_stable.solve_stable_d env val val1 amp
                let cf2 ← core.result.Result.Insts.CoreOpsTry.branch r2
                match cf2 with
                | core.ops.control_flow.ControlFlow.Continue val2 =>
                  let min_price ←
                    lift (core.cmp.impls.OrdI128.min a.price_wad b.price_wad)
                  let r3 ←
                    oracle.observation.try_amount_to_wad supply.total_shares
                      supply.decimals
                  let cf3 ← core.result.Result.Insts.CoreOpsTry.branch r3
                  match cf3 with
                  | core.ops.control_flow.ControlFlow.Continue val3 =>
                    if val3 <= 0#i128
                    then
                      ok (core.result.Result.Err
                        errors.OracleError.InvalidPrice)
                    else
                      let i ← lift (IScalar.hcast .U128 min_price)
                      let u ← aeneas_oracle_shim.U256.from_u128 env i
                      let u1 ← aeneas_oracle_shim.U256.mul val2 u
                      let i1 ← lift (IScalar.hcast .U128 val3)
                      let u2 ← aeneas_oracle_shim.U256.from_u128 env i1
                      let fair ← aeneas_oracle_shim.U256.div u1 u2
                      let o ← oracle.observation.try_u256_to_i128 fair
                      core.option.Option.ok_or o
                        errors.OracleError.InvalidPrice
                  | core.ops.control_flow.ControlFlow.Break residual =>
                    core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
                      Std.I128 (core.convert.FromSame errors.OracleError)
                      residual
                | core.ops.control_flow.ControlFlow.Break residual =>
                  core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
                    Std.I128 (core.convert.FromSame errors.OracleError)
                    residual
              | core.ops.control_flow.ControlFlow.Break residual =>
                core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
                  Std.I128 (core.convert.FromSame errors.OracleError) residual
            | core.ops.control_flow.ControlFlow.Break residual =>
              core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual
                Std.I128 (core.convert.FromSame errors.OracleError) residual

