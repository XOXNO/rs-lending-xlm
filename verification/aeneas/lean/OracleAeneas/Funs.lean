def math.fp_core.try_mul_div_half_up
  (env : aeneas_oracle_shim.Env) (x : Std.I128) (y : Std.I128) (d : Std.I128) :
  Result (Option Std.I128)
  := do
  if x < 0#i128
  then ok none
  else
    if y < 0#i128
    then ok none
    else
      if d <= 0#i128
      then ok none
      else
        let half ← d / 2#i128
        let o ← lift (I128.checked_mul x y)
        let o1 ←
          core.option.Option.and_then
            math.fp_core.try_mul_div_half_up.closure.Insts.CoreOpsFunctionFnOnceTupleI128OptionI128
            o half
        match o1 with
        | none =>
          let (x256, y256, d256) ← math.fp_core.to_i256_operands env x y d
          let i ← aeneas_oracle_shim.I256.mul x256 y256
          let i1 ← aeneas_oracle_shim.I256.from_i128 env half
          let i2 ← aeneas_oracle_shim.I256.add i i1
          let i3 ← aeneas_oracle_shim.I256.div i2 d256
          aeneas_oracle_shim.I256.to_i128 i3
        | some biased => let i ← biased / d
                         ok (some i)

