  have hk := pow_pos (show (0:Int) < 10 by norm_num) (27 - dec.val)
  have hA0 : 0 ≤ amount.val * 10^(27 - dec.val) := by positivity
  step with calculate_scaled_supply_spec env amount dec index hdec hidx ⟨by omega, hA⟩ hfit
