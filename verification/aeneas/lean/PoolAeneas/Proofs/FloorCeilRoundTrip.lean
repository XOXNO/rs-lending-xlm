/-- Every `n` has a floor by a nonzero `d` (the truncation candidate). -/
theorem exists_isFloor (n d : Int) (hd : d ≠ 0) : ∃ q, IsFloor n d q :=
  ⟨_, truncFloor_isFloor n d hd (decide (¬ d ∣ n)) (by simp)⟩

/-- Every `n` has a ceiling by a nonzero `d`. -/
