    (hA : amount.val * 10^(27 - dec.val) < 2^127)
    (hfit : ∃ q : Int, IsFloor (amount.val * 10^(27 - dec.val) * 10^27) index.val q ∧
      -2^127 ≤ q ∧ q < 2^127) :
