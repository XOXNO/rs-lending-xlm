def market_cache.shares.Cache.burn_claimable_revenue
  (self : market_cache.Cache) : Result (Std.I128 × market_cache.Cache) := do
  let treasury_actual ←
    market_cache.scale.Cache.unscale_supply_floor self self.revenue
  let amount ← lift (core.cmp.impls.OrdI128.min self.cash treasury_actual)
  if amount <= 0#i128
  then ok (0#i128, self)
  else
    let scaled_to_burn ←
      if amount >= treasury_actual
      then ok self.revenue
      else
        math.fp.Ray.mul_ratio_ceil self.revenue self.env amount treasury_actual
    let b ←
      core.cmp.PartialEq.ne.trait_default math.fp.Ray.Insts.CoreCmpPartialEqRay
        scaled_to_burn math.fp.Ray.ZERO
    massert b
    let r ← math.fp.Ray.checked_sub self.revenue self.env scaled_to_burn
    let r1 ← math.fp.Ray.checked_sub self.supplied self.env scaled_to_burn
    ok (amount, { self with supplied := r1, revenue := r })

