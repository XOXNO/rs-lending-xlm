/-- [pool_aeneas::ops::withdraw::accounting]:
    Source: 'src/../../../../contracts/pool/src/ops/withdraw.rs', lines 57:0-89:1 -/
def ops.withdraw.accounting
  (env : aeneas_pool_shim.Env) (is_liquidation : Bool)
  (entry : types.pool.PoolWithdrawEntry) :
  Result ops.withdraw.WithdrawOutcome
  := do
  validation.require_nonneg_amount env entry.protocol_fee
  let (cache, position) ← ops.load_leg env entry.action
  let (burned, gross_amount) ←
    ops.withdraw.resolve_close_or_partial cache entry.action.amount position
  let (remaining, cache1) ←
    ops.withdraw.burn_position env cache position burned
  let (net_transfer, cache2) ←
    ops.withdraw.withhold_liquidation_fee env cache1 gross_amount
      is_liquidation entry.protocol_fee
  let i ← math.fp.Ray.raw position
  let empty_close ←
    if i = 0#i128
    then ok (entry.action.amount = core.num.I128.MAX)
    else ok false
  if is_liquidation
  then
    let cache3 ← ops.withdraw.gate_and_debit env cache2 net_transfer true
    let snapshot ← market_cache.Cache.commit cache3
    let mutation ←
      market_cache.report.Cache.position_mutation cache3 remaining gross_amount
    ok { cache := cache3, mutation, snapshot, net_transfer }
  else
    let cache3 ←
      ops.withdraw.gate_and_debit env cache2 net_transfer empty_close
    let snapshot ← market_cache.Cache.commit cache3
    let mutation ←
      market_cache.report.Cache.position_mutation cache3 remaining gross_amount
    ok { cache := cache3, mutation, snapshot, net_transfer }

