def ops.seize.apply
  (env : aeneas_pool_shim.Env) (entry : types.pool.PoolSeizeEntry) :
  Result types.pool.MarketStateSnapshot
  := do
  validation.require_nonneg_amount env entry.position.scaled_amount
  let cache ← ops.synced_market env entry.hub_asset
  let position ←
    math.fp.Ray.from (core.convert.IntoFrom (core.convert.FromSame Std.I128))
      entry.position.scaled_amount
  let cache1 ←
    match entry.side with
    | types.shared.AccountPositionType.Deposit =>
      market_cache.shares.Cache.absorb_supply_as_revenue cache position
    | types.shared.AccountPositionType.Borrow =>
      do
      let bad_debt ←
        market_cache.scale.Cache.unscale_borrow_ceil_ray cache position
      let cache2 ← interest.apply_bad_debt_to_supply_index cache bad_debt
      market_cache.shares.Cache.burn_debt cache2 position
  market_cache.Cache.commit cache1

