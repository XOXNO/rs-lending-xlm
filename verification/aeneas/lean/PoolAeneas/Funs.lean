/-- [pool_aeneas::interest::apply_bad_debt_to_supply_index]:
    Source: 'src/../../../../contracts/pool/src/interest.rs', lines 73:0-89:1 -/
def interest.apply_bad_debt_to_supply_index
  (cache : market_cache.Cache) (bad_debt : math.fp.Ray) :
  Result market_cache.Cache
  := do
  let r ← market_cache.Cache.impl.supplied cache
  let e ← market_cache.Cache.impl.env cache
  let r1 ← market_cache.Cache.impl.supply_index cache
  let total_supplied_value ← math.fp.Ray.mul r e r1
  let b ←
    math.fp.Ray.Insts.CoreCmpPartialEqRay.eq total_supplied_value
      math.fp.Ray.ZERO
  if b
  then ok cache
  else
    let capped ←
      core.cmp.Ord.min.trait_default math.fp.Ray.Insts.CoreCmpOrd bad_debt
        total_supplied_value
    let remaining ← math.fp.Ray.checked_sub total_supplied_value e capped
    let reduction_factor ←
      math.fp.Ray.div_floor remaining e total_supplied_value
    let new_supply_index ← math.fp.Ray.mul_floor r1 e reduction_factor
    let i ← constants.pool.SUPPLY_INDEX_FLOOR_RAW
    let r2 ←
      math.fp.Ray.from (core.convert.IntoFrom (core.convert.FromSame Std.I128))
        i
    let r3 ←
      core.cmp.Ord.max.trait_default math.fp.Ray.Insts.CoreCmpOrd
        new_supply_index r2
    market_cache.report.Cache.set_supply_index cache r3

