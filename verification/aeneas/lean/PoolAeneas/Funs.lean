def guards.backing_shortfall
  (cache : market_cache.Cache) : Result Std.I128 := do
  let env ← market_cache.Cache.impl.env cache
  let r ← market_cache.Cache.impl.supplied cache
  let r1 ← market_cache.Cache.impl.supply_index cache
  let claims ← math.fp.Ray.mul_floor r env r1
  let r2 ← market_cache.Cache.impl.borrowed cache
  let debt ← market_cache.scale.Cache.unscale_borrow_ceil_ray cache r2
  let b ←
    core.cmp.PartialOrd.le.trait_default math.fp.Ray.Insts.CoreCmpPartialOrdRay
      claims debt
  if b
  then ok 0#i128
  else
    let r3 ← math.fp.Ray.checked_sub claims env debt
    let mp ← market_cache.Cache.impl.params cache
    let uncovered ← math.fp.Ray.to_asset_floor r3 env mp.asset_decimals
    let i ← market_cache.Cache.impl.cash cache
    let i1 ← lift (core.num.I128.saturating_sub uncovered i)
    ok (core.cmp.impls.OrdI128.max i1 0#i128)

