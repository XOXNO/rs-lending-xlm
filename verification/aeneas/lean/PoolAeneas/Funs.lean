def ops.strategy.compute_fee
  (env : aeneas_pool_shim.Env) (cache : market_cache.Cache) (amount : Std.I128)
  (charge_fee : Bool) :
  Result Std.I128
  := do
  if charge_fee
  then
    let mp ← market_cache.Cache.impl.params cache
    let i ← I128.Insts.CoreConvertFromU32.from mp.flashloan_fee
    let b ←
      math.fp.Bps.from (core.convert.IntoFrom (core.convert.FromSame Std.I128))
        i
    let fee ← math.fp.Bps.flash_loan_fee_on b env amount
    massert (fee <= amount)
    ok fee
  else ok 0#i128

