def math.fp_core.try_mul_div_half_up
  (env : aeneas_pool_shim.Env) (x : Std.I128) (y : Std.I128) (d : Std.I128) :
  Result (Option Std.I128)
  := do
  if x < 0#i128
  then ok none
  else
    if y < 0#i128
    then ok none
    else
      if d <= 0#i128
      then ok none
      else
        let half ← d / 2#i128
        let o ← lift (I128.checked_mul x y)
        let o1 ←
          core.option.Option.and_then
            math.fp_core.try_mul_div_half_up.closure.Insts.CoreOpsFunctionFnOnceTupleI128OptionI128
            o half
