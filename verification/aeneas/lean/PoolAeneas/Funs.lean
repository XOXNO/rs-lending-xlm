    math.fp.Ray.from (core.convert.IntoFrom (core.convert.FromSame Std.I128))
      entry.supply_position.scaled_amount
  let debt_position ←
    math.fp.Ray.from (core.convert.IntoFrom (core.convert.FromSame Std.I128))
      entry.debt_position.scaled_amount
  let (burned_supply, burned_debt, gross_amount) ←
    market_cache.scale.Cache.resolve_net_settle cache entry.amount
      supply_position debt_position
  if gross_amount = 0#i128
  then ok ()
  else
    do
    let i ← math.fp.Ray.raw burned_supply
    massert (i > 0#i128)
    let i1 ← math.fp.Ray.raw burned_debt
    massert (i1 > 0#i128)
  let cache1 ← market_cache.shares.Cache.burn_supply cache burned_supply
  let cache2 ← market_cache.shares.Cache.burn_debt cache1 burned_debt
  guards.require_supply_for_debt env cache2
  let snapshot ← market_cache.Cache.commit cache2
  let r ← math.fp.Ray.checked_sub supply_position env burned_supply
  let i ← math.fp.Ray.raw r
  let r1 ← math.fp.Ray.checked_sub debt_position env burned_debt
  let i1 ← math.fp.Ray.raw r1
  let mir ← market_cache.report.Cache.market_index cache2
  ok
    ({
       supply_position := { scaled_amount := i },
       debt_position := { scaled_amount := i1 },
       market_index := mir,
       settled_amount := gross_amount
     }, snapshot)

