def rates.compound.compound_interest_loop.body
  (env : aeneas_pool_shim.Env) (x : math.fp.Ray)
  (iter : core.array.iter.IntoIter Std.I128 7#usize) (sum : math.fp.Ray)
  (pow : math.fp.Ray) :
  Result (ControlFlow ((core.array.iter.IntoIter Std.I128 7#usize) ×
    math.fp.Ray × math.fp.Ray) math.fp.Ray)
  := do
