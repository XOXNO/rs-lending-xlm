def ops.withdraw.resolve_close_or_partial
  (cache : market_cache.Cache) (amount : Std.I128) (position : math.fp.Ray) :
  Result (math.fp.Ray × Std.I128)
  := do
  let (burned, gross_amount) ←
    market_cache.scale.Cache.resolve_withdrawal cache amount position
  if gross_amount = 0#i128
  then ok (burned, gross_amount)
