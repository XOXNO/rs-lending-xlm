  (env : aeneas_pool_shim.Env) (action : types.pool.PoolAction) :
  Result ops.repay.RepayOutcome
  := do
  let (cache, position) ← ops.load_leg env action
  let (burned, overpayment) ←
    market_cache.scale.Cache.resolve_repay cache action.amount position
  let o ← lift (I128.checked_sub action.amount overpayment)
  let net_repay ←
    core.option.Option.unwrap_or_else
      ops.repay.accounting.closure.Insts.CoreOpsFunctionFnOnceTupleI128 o env
  if net_repay = 0#i128
  then ok ()
  else do
       let i ← math.fp.Ray.raw burned
       massert (i > 0#i128)
  let position1 ← math.fp.Ray.checked_sub position env burned
  let cache1 ← market_cache.shares.Cache.burn_debt cache burned
  let cache2 ← market_cache.cash.Cache.credit_cash cache1 net_repay
  let snapshot ← market_cache.Cache.commit cache2
  let mutation ←
    market_cache.report.Cache.position_mutation cache2 position1 net_repay
  ok { cache := cache2, mutation, snapshot, overpayment }

