    core.array.iter.IntoIter.Insts.CoreIterTraitsIteratorIterator.next iter
  match o with
  | none => ok (done sum)
  | some divisor =>
    let pow1 ← math.fp.Ray.mul pow env x
    let r ← math.fp.Ray.div_by_int pow1 env divisor
    let sum1 ← math.fp.Ray.checked_add sum env r
    ok (cont (iter1, sum1, pow1))

