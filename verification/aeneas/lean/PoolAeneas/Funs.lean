  let minted ←
    market_cache.scale.Cache.calculate_scaled_supply cache entry.action.amount
  if entry.action.amount = 0#i128
  then ok ()
  else do
       let i ← math.fp.Ray.raw minted
       massert (i > 0#i128)
  let position1 ← math.fp.Ray.checked_add position env minted
  let cache1 ← market_cache.shares.Cache.mint_supply cache minted
  let cache2 ← market_cache.cash.Cache.credit_cash cache1 entry.action.amount
  let snapshot ← market_cache.Cache.commit cache2
  let ppm ←
    market_cache.report.Cache.position_mutation cache2 position1
      entry.action.amount
  ok (ppm, snapshot)

