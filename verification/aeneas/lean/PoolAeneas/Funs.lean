  (env : aeneas_pool_shim.Env) (cache : market_cache.Cache) (draw : Std.I128) :
  Result Unit
  := do
  let r ← market_cache.Cache.impl.supplied cache
  let supplied ← market_cache.scale.Cache.unscale_supply_floor cache r
  let b ←
    math.fp.Bps.from (core.convert.IntoFrom (core.convert.FromSame Std.I128))
      constants.pool.LIQUIDATION_BUFFER_BPS
  let reserved ← math.fp.Bps.apply_to_ceil b env supplied
  let i ← market_cache.Cache.impl.cash cache
  let i1 ← lift (core.num.I128.saturating_sub i draw)
  massert (i1 >= reserved)

