        | none =>
          let (x256, y256, d256) ← math.fp_core.to_i256_operands env x y d
          let i ← aeneas_pool_shim.I256.mul x256 y256
          let i1 ← aeneas_pool_shim.I256.from_i128 env half
          let i2 ← aeneas_pool_shim.I256.add i i1
          let i3 ← aeneas_pool_shim.I256.div i2 d256
          aeneas_pool_shim.I256.to_i128 i3
        | some biased => let i ← biased / d
                         ok (some i)

