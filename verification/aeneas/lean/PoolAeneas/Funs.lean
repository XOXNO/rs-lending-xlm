def rates.curve.calculate_borrow_rate
  (env : aeneas_pool_shim.Env) (utilization : math.fp.Ray)
  (params : types.pool.MarketParams) :
  Result math.fp.Ray
  := do
  let r ← rates.curve.calculate_annual_borrow_rate env utilization params
  let i ← lift (UScalar.hcast .I128 constants.shared.MILLISECONDS_PER_YEAR)
  math.fp.Ray.div_by_int r env i

/-- [pool_aeneas::rates::curve::utilization]:
    Source: 'src/../../../../common/src/rates/curve.rs', lines 118:0-126:1
    Visibility: public -/
def rates.curve.utilization
  (env : aeneas_pool_shim.Env) (borrowed : math.fp.Ray)
  (supplied : math.fp.Ray) :
  Result math.fp.Ray
  := do
  let b ← math.fp.Ray.Insts.CoreCmpPartialEqRay.eq supplied math.fp.Ray.ZERO
  if b
  then ok math.fp.Ray.ZERO
  else
    let b1 ←
      core.cmp.PartialOrd.lt.trait_default
        math.fp.Ray.Insts.CoreCmpPartialOrdRay borrowed math.fp.Ray.ZERO
    massert (¬ b1)
    let b2 ←
      core.cmp.PartialOrd.lt.trait_default
        math.fp.Ray.Insts.CoreCmpPartialOrdRay supplied math.fp.Ray.ZERO
    massert (¬ b2)
    let o ← math.fp.Ray.try_div borrowed env supplied
    ok (core.option.Option.unwrap_or o math.fp.Ray.ONE)

