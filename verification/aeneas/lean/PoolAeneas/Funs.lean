def ops.withdraw.withhold_liquidation_fee
  (env : aeneas_pool_shim.Env) (cache : market_cache.Cache)
  (gross_amount : Std.I128) (is_liquidation : Bool) (protocol_fee : Std.I128) :
  Result (Std.I128 × market_cache.Cache)
  := do
  massert ((¬ is_liquidation) || ((protocol_fee = 0#i128) || (gross_amount >=
    protocol_fee)))
  if is_liquidation
  then
    if protocol_fee = 0#i128
    then ok (gross_amount, cache)
    else
      let mp ← market_cache.Cache.impl.params cache
      let fee ← math.fp.Ray.from_asset env protocol_fee mp.asset_decimals
      let cache1 ← interest.add_protocol_revenue cache fee
      let o ← lift (I128.checked_sub gross_amount protocol_fee)
      let gross_amount1 ←
        core.option.Option.unwrap_or_else
          ops.withdraw.withhold_liquidation_fee.closure.Insts.CoreOpsFunctionFnOnceTupleI128
          o env
      ok (gross_amount1, cache1)
  else ok (gross_amount, cache)

