def ops.strategy.accounting
  (env : aeneas_pool_shim.Env) (action : types.pool.PoolAction)
  (charge_fee : Bool) :
  Result ops.strategy.StrategyOutcome
  := do
  validation.require_nonneg_amount env action.amount
  validation.require_nonneg_amount env action.position.scaled_amount
  let cache ← ops.renewed_market env action.hub_asset
  let fee ← ops.strategy.compute_fee env cache action.amount charge_fee
  let position ←
    math.fp.Ray.from (core.convert.IntoFrom (core.convert.FromSame Std.I128))
      action.position.scaled_amount
  let (cache1, position1) ←
    ops.borrow.mint_debt env cache position action.amount
  let mp ← market_cache.Cache.impl.params cache1
  let protocol_fee ← math.fp.Ray.from_asset env fee mp.asset_decimals
  let cache2 ← interest.add_protocol_revenue cache1 protocol_fee
  let o ← lift (I128.checked_sub action.amount fee)
  let amount_to_send ←
    core.option.Option.unwrap_or_else
      ops.strategy.accounting.closure.Insts.CoreOpsFunctionFnOnceTupleI128 o
      env
  let cache3 ← market_cache.cash.Cache.debit_cash cache2 amount_to_send
  let _ ← market_cache.Cache.commit cache3
  let mutation ←
    market_cache.report.Cache.strategy_mutation cache3 position1 action.amount
      amount_to_send
  ok { cache := cache3, mutation, fee }

