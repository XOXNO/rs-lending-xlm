/-- [rates_aeneas::math::fp::{rates_aeneas::math::fp::Wad}::try_value_of_token]:
    Source: 'src/../../../common/src/math/fp.rs', lines 302:4-305:5
    Visibility: public -/
def math.fp.Wad.try_value_of_token
  (self : math.fp.Wad) (env : aeneas_soroban_shim.Env) (amount : Std.I128)
  (decimals : Std.U32) :
  Result (Option math.fp.Wad)
  := do
  let o ← core.num.I128.checked_pow 10#i128 decimals
  let cf ← core.option.Option.Insts.CoreOpsTry_traitTry.branch o
  match cf with
  | core.ops.control_flow.ControlFlow.Continue val =>
    let o1 ← math.fp_core.try_mul_div_half_up env amount self val
    core.option.Option.map P.Insts.CoreOpsFunctionFnOnceTupleI128Wad o1
      (math.fp.Wad.constructor)
  | core.ops.control_flow.ControlFlow.Break residual =>
    core.option.Option.Insts.CoreOpsTry_traitFromResidualOptionNever.from_residual
      math.fp.Wad residual

/-- [rates_aeneas::math::fp::{rates_aeneas::math::fp::Wad}::try_from_token_upscale]:
    Source: 'src/../../../common/src/math/fp.rs', lines 308:4-314:5
    Visibility: public -/
def math.fp.Wad.try_from_token_upscale
  (amount : Std.I128) (decimals : Std.U32) : Result (Option math.fp.Wad) := do
  if amount < 0#i128
  then ok none
  else
    let o ←
      lift (U32.checked_sub constants.production.shared.WAD_DECIMALS decimals)
    let cf ← core.option.Option.Insts.CoreOpsTry_traitTry.branch o
    match cf with
    | core.ops.control_flow.ControlFlow.Continue val =>
      let o1 ← core.num.I128.checked_pow 10#i128 val
      let cf1 ← core.option.Option.Insts.CoreOpsTry_traitTry.branch o1
      match cf1 with
      | core.ops.control_flow.ControlFlow.Continue val1 =>
        let o2 ← lift (I128.checked_mul amount val1)
        core.option.Option.map P.Insts.CoreOpsFunctionFnOnceTupleI128Wad o2
          (math.fp.Wad.constructor)
      | core.ops.control_flow.ControlFlow.Break residual =>
        core.option.Option.Insts.CoreOpsTry_traitFromResidualOptionNever.from_residual
          math.fp.Wad residual
    | core.ops.control_flow.ControlFlow.Break residual =>
      core.option.Option.Insts.CoreOpsTry_traitFromResidualOptionNever.from_residual
        math.fp.Wad residual

