/-- [rates_aeneas::rates::scaling::resolve_repay]:
    Source: 'src/../../../common/src/rates/scaling.rs', lines 164:0-185:1
    Visibility: public -/
def rates.scaling.resolve_repay
  (env : aeneas_soroban_shim.Env) (amount : Std.I128)
  (pos_scaled : math.fp.Ray) (borrow_index : math.fp.Ray) (decimals : Std.U32)
  :
  Result (math.fp.Ray × Std.I128)
  := do
  let current_debt_ceil ←
    rates.scaling.unscale_borrow_ceil env pos_scaled borrow_index decimals
