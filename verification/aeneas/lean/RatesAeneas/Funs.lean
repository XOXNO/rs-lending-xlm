/-- [rates_aeneas::rates::scaling::resolve_withdrawal]:
    Source: 'src/../../../common/src/rates/scaling.rs', lines 98:0-114:1
    Visibility: public -/
def rates.scaling.resolve_withdrawal
  (env : aeneas_soroban_shim.Env) (amount : Std.I128)
  (pos_scaled : math.fp.Ray) (supply_index : math.fp.Ray) (decimals : Std.U32)
  :
  Result (math.fp.Ray × Std.I128)
  := do
  let current_supply_actual ←
    rates.scaling.unscale_supply env pos_scaled supply_index decimals
  let current_supply_floor ←
    rates.scaling.unscale_supply_floor env pos_scaled supply_index decimals
  if amount >= current_supply_actual
  then ok (pos_scaled, current_supply_floor)
  else
    let r ←
      rates.scaling.calculate_scaled_supply_ceil env amount decimals
        supply_index
    ok (r, amount)

/-- [rates_aeneas::rates::scaling::resolve_net_settle]:
    Source: 'src/../../../common/src/rates/scaling.rs', lines 126:0-154:1
    Visibility: public -/
def rates.scaling.resolve_net_settle
  (env : aeneas_soroban_shim.Env) (amount : Std.I128)
  (supply_scaled : math.fp.Ray) (debt_scaled : math.fp.Ray)
  (supply_index : math.fp.Ray) (borrow_index : math.fp.Ray)
  (decimals : Std.U32) :
  Result (math.fp.Ray × math.fp.Ray × Std.I128)
  := do
  let supply_floor ←
    rates.scaling.unscale_supply_floor env supply_scaled supply_index decimals
  let debt_ceil ←
    rates.scaling.unscale_borrow_ceil env debt_scaled borrow_index decimals
  let i ← lift (core.cmp.impls.OrdI128.min amount supply_floor)
  let settle ← lift (core.cmp.impls.OrdI128.min i debt_ceil)
  if settle <= 0#i128
  then ok (math.fp.Ray.ZERO, math.fp.Ray.ZERO, 0#i128)
  else
    let burned_supply ←
      if settle = supply_floor
      then ok supply_scaled
      else
        do
        let r ←
          rates.scaling.calculate_scaled_supply_ceil env settle decimals
            supply_index
        core.cmp.Ord.min.trait_default math.fp.Ray.Insts.CoreCmpOrd r
          supply_scaled
    if settle = debt_ceil
    then ok (burned_supply, debt_scaled, settle)
    else
      let r ←
        rates.scaling.calculate_scaled_borrow_floor env settle decimals
          borrow_index
      let burned_debt ←
        core.cmp.Ord.min.trait_default math.fp.Ray.Insts.CoreCmpOrd r
          debt_scaled
      ok (burned_supply, burned_debt, settle)

