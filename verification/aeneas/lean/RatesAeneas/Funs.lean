/-- [rates_aeneas::rates::curve::calculate_annual_borrow_rate]:
    Source: 'src/../../../common/src/rates/curve.rs', lines 26:0-63:1
    Visibility: public -/
def rates.curve.calculate_annual_borrow_rate
  (env : aeneas_soroban_shim.Env) (utilization : math.fp.Ray)
  (params : types.MarketParams) :
  Result math.fp.Ray
  := do
  let b ←
    core.cmp.PartialOrd.gt.trait_default math.fp.Ray.Insts.CoreCmpPartialOrdRay
      utilization math.fp.Ray.ONE
  let utilization1 ← if b
                       then ok math.fp.Ray.ONE
                       else ok utilization
  let b1 ←
    core.cmp.PartialOrd.lt.trait_default math.fp.Ray.Insts.CoreCmpPartialOrdRay
      utilization1 params.mid_utilization
  let annual_rate ←
    if b1
    then
      do
      let contribution ←
        rates.curve.slope_contribution env utilization1 params.slope1
          params.mid_utilization
      math.fp.Ray.checked_add params.base_borrow_rate env contribution
    else
      do
      let b2 ←
        core.cmp.PartialOrd.lt.trait_default
          math.fp.Ray.Insts.CoreCmpPartialOrdRay utilization1
          params.optimal_utilization
      if b2
      then
        let excess ←
          math.fp.Ray.checked_sub utilization1 env params.mid_utilization
        let range ←
          math.fp.Ray.checked_sub params.optimal_utilization env
            params.mid_utilization
        let contribution ←
          rates.curve.slope_contribution env excess params.slope2 range
        let r ←
          math.fp.Ray.checked_add params.base_borrow_rate env params.slope1
        math.fp.Ray.checked_add r env contribution
      else
        let r ←
          math.fp.Ray.checked_add params.base_borrow_rate env params.slope1
        let base_rate ← math.fp.Ray.checked_add r env params.slope2
        let excess ←
          math.fp.Ray.checked_sub utilization1 env params.optimal_utilization
        let range ←
          math.fp.Ray.checked_sub math.fp.Ray.ONE env
            params.optimal_utilization
        let contribution ←
          rates.curve.slope_contribution env excess params.slope3 range
        math.fp.Ray.checked_add base_rate env contribution
  let b2 ←
    core.cmp.PartialOrd.gt.trait_default math.fp.Ray.Insts.CoreCmpPartialOrdRay
      annual_rate params.max_borrow_rate
  if b2
  then ok params.max_borrow_rate
  else ok annual_rate

/-- [rates_aeneas::rates::curve::calculate_borrow_rate]:
    Source: 'src/../../../common/src/rates/curve.rs', lines 79:0-82:1
    Visibility: public -/
def rates.curve.calculate_borrow_rate
  (env : aeneas_soroban_shim.Env) (utilization : math.fp.Ray)
  (params : types.MarketParams) :
  Result math.fp.Ray
  := do
  let r ← rates.curve.calculate_annual_borrow_rate env utilization params
  let i ←
    lift (UScalar.hcast .I128
      constants.production.shared.MILLISECONDS_PER_YEAR)
  math.fp.Ray.div_by_int r env i

/-- [rates_aeneas::rates::curve::calculate_deposit_rate]:
    Source: 'src/../../../common/src/rates/curve.rs', lines 93:0-110:1
    Visibility: public -/
def rates.curve.calculate_deposit_rate
  (env : aeneas_soroban_shim.Env) (utilization : math.fp.Ray)
  (borrow_rate : math.fp.Ray) (reserve_factor : math.fp.Bps) :
  Result math.fp.Ray
  := do
  let b ←
    math.fp.Ray.Insts.CoreCmpPartialEqRay.eq utilization math.fp.Ray.ZERO
  if b
  then ok math.fp.Ray.ZERO
  else
    let i ← math.fp.Bps.raw reserve_factor
    let b1 ←
      core.ops.range.Range.contains core.cmp.PartialOrdI128
        core.cmp.PartialOrdI128 core.cmp.PartialOrdI128
        { start := 0#i128, «end» := constants.production.shared.BPS } i
    if b1
    then
      let rate_x_util ← math.fp.Ray.mul utilization env borrow_rate
      let i1 ← constants.production.shared.BPS - i
      let supplier_share ←
        math.fp.Bps.from (core.convert.IntoFrom (core.convert.FromSame
          Std.I128)) i1
      math.fp.Bps.apply_to_ray supplier_share env rate_x_util
    else ok math.fp.Ray.ZERO

/-- [rates_aeneas::rates::curve::utilization]:
    Source: 'src/../../../common/src/rates/curve.rs', lines 121:0-132:1
    Visibility: public -/
def rates.curve.utilization
  (env : aeneas_soroban_shim.Env) (borrowed : math.fp.Ray)
  (supplied : math.fp.Ray) :
  Result math.fp.Ray
  := do
  let b ← math.fp.Ray.Insts.CoreCmpPartialEqRay.eq supplied math.fp.Ray.ZERO
  if b
  then ok math.fp.Ray.ZERO
  else
    let b1 ←
      core.cmp.PartialOrd.lt.trait_default
        math.fp.Ray.Insts.CoreCmpPartialOrdRay borrowed math.fp.Ray.ZERO
    massert (¬ b1)
    let b2 ←
      core.cmp.PartialOrd.lt.trait_default
        math.fp.Ray.Insts.CoreCmpPartialOrdRay supplied math.fp.Ray.ZERO
    massert (¬ b2)
    let b3 ←
      core.cmp.PartialOrd.ge.trait_default
        math.fp.Ray.Insts.CoreCmpPartialOrdRay borrowed supplied
    if b3
    then ok math.fp.Ray.ONE
    else math.fp.Ray.div borrowed env supplied

/-- [rates_aeneas::rates::index::update_borrow_index]:
    Source: 'src/../../../common/src/rates/index.rs', lines 12:0-18:1
    Visibility: public -/
def rates.index.update_borrow_index
  (env : aeneas_soroban_shim.Env) (old_index : math.fp.Ray)
  (interest_factor : math.fp.Ray) :
  Result math.fp.Ray
  := do
  let new_index ← math.fp.Ray.mul old_index env interest_factor
  let i ← math.fp.Ray.raw new_index
  if i > constants.production.pool.MAX_BORROW_INDEX_RAY
  then
    math.fp.Ray.from (core.convert.IntoFrom (core.convert.FromSame Std.I128))
      constants.production.pool.MAX_BORROW_INDEX_RAY
  else ok new_index

/-- [rates_aeneas::rates::index::update_supply_index]:
    Source: 'src/../../../common/src/rates/index.rs', lines 28:0-43:1
    Visibility: public -/
def rates.index.update_supply_index
  (env : aeneas_soroban_shim.Env) (supplied : math.fp.Ray)
  (old_index : math.fp.Ray) (rewards_increase : math.fp.Ray) :
  Result math.fp.Ray
  := do
  let b ← math.fp.Ray.Insts.CoreCmpPartialEqRay.eq supplied math.fp.Ray.ZERO
  if b
  then ok old_index
  else
    let b1 ←
      math.fp.Ray.Insts.CoreCmpPartialEqRay.eq rewards_increase
        math.fp.Ray.ZERO
    if b1
    then ok old_index
    else
      let total_supplied_value ← math.fp.Ray.mul supplied env old_index
      let b2 ←
        math.fp.Ray.Insts.CoreCmpPartialEqRay.eq total_supplied_value
          math.fp.Ray.ZERO
      if b2
      then ok old_index
      else
        let new_value ←
          math.fp.Ray.checked_add total_supplied_value env rewards_increase
        let grown ← math.fp.Ray.div_floor_saturating new_value env supplied
        let cap ←
          math.fp.Ray.from (core.convert.IntoFrom (core.convert.FromSame
            Std.I128)) constants.production.pool.MAX_SUPPLY_INDEX_RAY
        let r ←
          core.cmp.Ord.min.trait_default math.fp.Ray.Insts.CoreCmpOrd grown cap
        let r1 ←
          core.cmp.Ord.min.trait_default math.fp.Ray.Insts.CoreCmpOrd old_index
            cap
        core.cmp.Ord.max.trait_default math.fp.Ray.Insts.CoreCmpOrd r r1

/-- [rates_aeneas::rates::index::supply_index_reward_shortfall]:
    Source: 'src/../../../common/src/rates/index.rs', lines 51:0-62:1
    Visibility: public -/
def rates.index.supply_index_reward_shortfall
  (env : aeneas_soroban_shim.Env) (supplied : math.fp.Ray)
  (old_index : math.fp.Ray) (new_index : math.fp.Ray)
  (rewards_increase : math.fp.Ray) :
  Result math.fp.Ray
  := do
  let r ← math.fp.Ray.mul supplied env new_index
  let r1 ← math.fp.Ray.mul supplied env old_index
  let distributed ← math.fp.Ray.checked_sub r env r1
  math.fp.Ray.checked_sub rewards_increase env distributed

/-- [rates_aeneas::rates::index::calculate_supplier_rewards]:
    Source: 'src/../../../common/src/rates/index.rs', lines 71:0-87:1
    Visibility: public -/
def rates.index.calculate_supplier_rewards
  (env : aeneas_soroban_shim.Env) (params : types.MarketParams)
  (borrowed : math.fp.Ray) (new_borrow_index : math.fp.Ray)
  (old_borrow_index : math.fp.Ray) :
  Result (math.fp.Ray × math.fp.Ray)
  := do
  let old_total_debt ← math.fp.Ray.mul borrowed env old_borrow_index
  let new_total_debt ← math.fp.Ray.mul borrowed env new_borrow_index
  let accrued_interest ←
    math.fp.Ray.checked_sub new_total_debt env old_total_debt
  let protocol_fee ←
    math.fp.Bps.apply_to_ray params.reserve_factor env accrued_interest
  let supplier_rewards ←
    math.fp.Ray.checked_sub accrued_interest env protocol_fee
  ok (supplier_rewards, protocol_fee)

/-- [rates_aeneas::rates::index::protocol_fee_shares]:
    Source: 'src/../../../common/src/rates/index.rs', lines 92:0-97:1
    Visibility: public -/
def rates.index.protocol_fee_shares
  (env : aeneas_soroban_shim.Env) (fee : math.fp.Ray)
  (supply_index : math.fp.Ray) (supplied : math.fp.Ray) :
  Result math.fp.Ray
  := do
  let r ← math.fp.Ray.div_floor_saturating fee env supply_index
  let raw ← math.fp.Ray.raw r
  let i ← math.fp.Ray.raw supplied
  let headroom ← lift (core.num.I128.saturating_sub core.num.I128.MAX i)
  let i1 ← lift (core.cmp.impls.OrdI128.min raw headroom)
  math.fp.Ray.from (core.convert.IntoFrom (core.convert.FromSame Std.I128)) i1

