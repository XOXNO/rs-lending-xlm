# Komet proof pipeline pins. Every value is a digest, commit or SHA-256;
# nothing floats. scripts/build-images.sh passes these as build arguments.

# Runtime Verification K 7.1.337 image (ships K, LLVM/Haskell backends, Python 3.10).
K_IMAGE=runtimeverificationinc/kframework-k:ubuntu-jammy-7.1.337@sha256:a63698c015f2b349bb9807d486bf2a48a764237a018fd207c23ac7571519b12b

# Kore/Booster backend: XOXNO/haskell-backend branch proof/booster-v6-compact-rpc
# (v0.1.155 + definedness/map-key/compact-RPC changes of the original proof runtime).
# The dependency layer is built once at the earlier repair commit and reused.
HASKELL_BACKEND_REPO=https://github.com/XOXNO/haskell-backend.git
HASKELL_BACKEND_DEPS_COMMIT=bc935ed495c8e1613b294d875d016b0fad469038
HASKELL_BACKEND_COMMIT=818a5e4c79275505c3adaadf1d6a6338362c5b47
STACK_VERSION=2.15.7
STACK_SHA256=4e635d6168f7578a5694a0d473c980c3c7ed35d971acae969de1fd48ef14e030
# Backend flags recorded with the original borrow-double proof.
BOOSTER_FLAGS="--equation-max-local-steps 32 --no-fallback-simplify --no-post-exec-simplify --smt-retry-limit 3"

# Z3 official release (x64 glibc 2.35 build); zip and extracted binary.
Z3_VERSION=4.13.4
Z3_ZIP_SHA256=93f91f9c6f4a00a041c19fc7a74adc1f441c8244ce70d486e19abcd89c6a014b
Z3_BIN_SHA256=e0385660ab6f1314049376c6188e70ab91692cdca4680b7b1cb42cac258ea836

# Python environment manager and Stellar CLI (same pin as .github/scripts/install-stellar-cli.sh).
UV_VERSION=0.11.32
UV_SHA256=aab924fd522efd06f1c5f3b93a243864fc453132c94b2dc49f1371b528a4b967
STELLAR_VERSION=28.0.0
STELLAR_SHA256=207544486734fccb4df1afc4a7745478f9f1e21688b2f9506f0ef36f60ce3fdc

# Komet fork: XOXNO/komet branch proof/borrow-double-repro-2026-11 (semantics,
# lemma modules, proof runner, vendor/pyk-overlay); source hashes checked in the image.
KOMET_REPO=https://github.com/XOXNO/komet.git
KOMET_COMMIT=7e74d11c9e330326d8d3b7b055cd29b0206139ce
KOMET_LEMMAS_SHA256=2ddebe516fe9b93c95e0ecaa1734b9226917fefebfbe44c7f77ee8bd855853c4
KOMET_PROOF_PY_SHA256=ac43e6cafd049c505f81b5e363968c509d656de5c9d57ab81c1eea091654a8e2

# Harness Wasm builder: Rust 1.95.0 (wasm32v1-none) + the same Stellar CLI.
RUST_IMAGE=rust:1.95.0-slim-bookworm@sha256:d7482085ff5b415f84dba5647ae71606650bdef00db7aeb69f4b3d170c3e4082

# Lean 4.22.0 release for the arithmetic lemmas (checked with --trust=0).
LEAN_VERSION=4.22.0
LEAN_TAR_SHA256=85097a4d659fe388193a5efb0c413b880e101f1290cc41d00eb60847b18f064e
LEAN_BIN_SHA256=cbf5fd536e142ef1beaccf33f788fd8a7f3f29fb214e75c11319a8d8677b4b2b
