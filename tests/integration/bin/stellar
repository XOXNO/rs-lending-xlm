#!/usr/bin/env bash
case "${E2E_STELLAR:-}" in
    /*) [ ! "$E2E_STELLAR" -ef "${BASH_SOURCE[0]}" ] || { echo 'error: E2E_STELLAR names the RPC shim itself' >&2; exit 1; };;
    *) echo 'error: E2E_STELLAR must be the absolute path of the stellar CLI' >&2; exit 1;;
esac
case "${1:-} ${2:-}" in
    'keys fund') ;;
    --version*|'version '*|'keys '*|'xdr '*|'tx sign'|'tx hash'|'tx decode'|'tx encode'|'tx op'|'contract id'|'contract alias')
        case " $* " in *' --fund '*) ;; *) exec "$E2E_STELLAR" "$@";; esac;;
esac
pool=
case "${1:-} ${2:-}" in 'tx simulate'|'contract fetch'|'fees stats'|'ledger '*) pool='read';; esac
case " $* " in *' --send=no '*|*' --build-only '*) pool='read';; esac
INTEG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)" || exit 1
source "$INTEG_DIR/lib/core.sh" || exit 1
case "${1:-} ${2:-}| $* " in
    'tx send|'*|'keys fund|'*|*' --fund '*) rpc_hold "$pool" || exit 1; exec "$E2E_STELLAR" "$@";;
    'tx simulate|'*) [ -f /dev/stdin ] || { rpc_hold "$pool" || exit 1; exec "$E2E_STELLAR" "$@"; };;
esac
work=$(mktemp -d "${TMPDIR:-/tmp}/e2e-stellar.XXXXXX") || exit 1
trap 'rm -rf "$work"' EXIT
if [ "${1:-} ${2:-}" = 'tx simulate' ]; then cat > "$work/in" || exit 1; else : > "$work/in"; fi
n=0
while :; do
    rc=0
    if [ -s "$work/in" ]; then
        ( rpc_hold "$pool" || exit 1; exec "$E2E_STELLAR" "$@" ) <"$work/in" >"$work/out" 2>"$work/err" || rc=$?
    else
        ( rpc_hold "$pool" || exit 1; exec "$E2E_STELLAR" "$@" ) >"$work/out" 2>"$work/err" || rc=$?
    fi
    [ "$rc" -ne 0 ] \
        && ! grep -qE 'Signing transaction: [0-9a-f]{64}|Error\(Contract' "$work/err" \
        && grep -qE 'Request rejected .?(429|50[0-9])|status_code: (429|50[0-9])|Too Many Requests|error reading a body|error sending request|connection (reset|refused|closed)|tcp connect error' "$work/err" \
        || break
    n=$((n + 1))
    throttle_sleep "$n" || break
done
cat "$work/out"
cat "$work/err" >&2
exit "$rc"
