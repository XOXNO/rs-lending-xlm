          ]
        }
      }
    },
    {
      "id": 903,
      "type": "timeseries",
      "title": "Transactions by kind and outcome",
      "description": "Transactions per 24h by kind and status: success, retriable, failed, error, dry_run_ok. KeeperTxFailures fires on failed and error.",
      "datasource": {
        "type": "prometheus",
        "uid": "cfgw0aa7mups0d"
      },
      "gridPos": {
