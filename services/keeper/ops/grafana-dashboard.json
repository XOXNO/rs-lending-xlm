    },
    {
      "id": 7,
      "type": "stat",
      "title": "Entries awaiting restore",
      "description": "Discovered entries already expired. Non-zero means state is archived and calls against it will fail until restored.",
      "datasource": {
        "type": "prometheus",
        "uid": "cfgw0aa7mups0d"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "keeper_entries_archived{network=\"$network\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "cfgw0aa7mups0d"
          },
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Jobs planned per day",
      "description": "Jobs the keeper planned per day. Zero is normal when everything is far from its margin. Averaged over 24h because the TTL loop only ticks every 6h \u2014 a 1h window would read zero even while work was happening.",
      "datasource": {
        "type": "prometheus",
        "uid": "cfgw0aa7mups0d"
      },
      "gridPos": {
        "x": 6,
        "y": 27,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(keeper_jobs_planned_total{network=\"$network\"}[24h])) * 86400",
          "datasource": {
            "type": "prometheus",
            "uid": "cfgw0aa7mups0d"
          },
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Simulation failures per day",
      "description": "Simulation rejections per day, summed over job kind and reason. Averaged over 24h because the TTL loop only ticks every 6h \u2014 a 1h window would read zero even while work was happening.",
      "datasource": {
        "type": "prometheus",
        "uid": "cfgw0aa7mups0d"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(keeper_sim_failures_total{network=\"$network\"}[24h])) * 86400",
          "datasource": {
            "type": "prometheus",
            "uid": "cfgw0aa7mups0d"
          },
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
