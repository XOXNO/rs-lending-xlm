    {
      "id": 902,
      "type": "timeseries",
      "title": "Tick failures by loop",
      "description": "Tick errors per hour by loop (ttl, index). Above zero means a tick runs and returns an error. Zero, with a stale last-tick age, means the loop is not reaching a tick at all.",
      "datasource": {
        "type": "prometheus",
        "uid": "cfgw0aa7mups0d"
      },
      "gridPos": {
        "x": 8,
        "y": 33,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
