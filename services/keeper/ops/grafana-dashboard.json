    {
      "id": 901,
      "type": "alertlist",
      "title": "Keeper alerts",
      "description": "Imported rules carry no dashboard/panel link, so nothing marks a firing alert on the panels above. This lists them instead.",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 8,
        "h": 9
      },
      "options": {
        "alertInstanceLabelFilter": "",
        "alertName": "Keeper",
        "dashboardAlerts": false,
        "groupBy": [],
        "groupMode": "default",
        "maxItems": 20,
        "sortOrder": 1,
        "stateFilter": {
          "error": true,
          "firing": true,
          "noData": false,
          "normal": false,
