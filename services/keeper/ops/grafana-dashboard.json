{
  "title": "Stellar Lending Keeper \u2014 Storage & TTL",
  "uid": "stellar-lending-keeper",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "tags": [
    "stellar",
    "lending",
    "keeper"
  ],
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Status \u2014 read these four first",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Days until first action",
      "description": "Lowest TTL headroom minus the safety margin. This is the whole dashboard in one number: how long before the keeper must extend anything. Negative means it should be acting now.",
      "datasource": {
        "type": "prometheus",
        "uid": "cfgw0aa7mups0d"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(min(keeper_entry_ttl_ledgers_min{network=\"$network\"}) - min(keeper_safety_margin_ledgers{network=\"$network\"})) / 17280",
          "datasource": {
            "type": "prometheus",
            "uid": "cfgw0aa7mups0d"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 7
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "auto"
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "Entries awaiting restore",
      "description": "Entries planned for restore by the last TTL tick. Submission depends on the transaction budget, dry-run mode and simulation outcome; calls that touch unrestored entries fail. Reads 0 until the first TTL tick after boot.",
      "datasource": {
        "type": "prometheus",
        "uid": "cfgw0aa7mups0d"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "keeper_entries_archived{network=\"$network\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "cfgw0aa7mups0d"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "auto"
      }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Key groups with nothing live",
      "description": "Groups where every probed key came back never_created. Baseline is 1 (controller/roles \u2014 the controller has no access-control roles). A rise above that is how a wrong key encoding presents; alert KeeperKeyGroupUnreachable covers it.",
      "datasource": {
        "type": "prometheus",
        "uid": "cfgw0aa7mups0d"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count( (sum by (contract,group) (keeper_entries{network=\"$network\",state=\"never_created\"}) > 0) unless (sum by (contract,group) (keeper_entries{network=\"$network\",state=\"live\"}) > 0) ) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "cfgw0aa7mups0d"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "text",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "auto"
      }
    },
    {
      "id": 104,
      "type": "stat",
      "title": "Last tick age",
      "description": "Age of the storage figures on this dashboard. The keeper publishes them at boot and on each TTL tick (every 6h on mainnet), so expect up to 6h. Much more means the keeper is not ticking.",
      "datasource": {
        "type": "prometheus",
        "uid": "cfgw0aa7mups0d"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - keeper_last_tick_timestamp_seconds{network=\"$network\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "cfgw0aa7mups0d"
          },
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 25200
              },
              {
                "color": "red",
                "value": 43200
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "auto"
      }
    },
    {
      "id": 1,
      "type": "row",
      "title": "Storage & TTL",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "TTL headroom by contract and key group",
      "description": "Lowest remaining TTL in each group, in days. The keeper extends an entry once its TTL falls below the safety margin. Red below 21 days, the mainnet safety margin.",
      "datasource": {
        "type": "prometheus",
        "uid": "cfgw0aa7mups0d"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "refId": "TTL",
          "expr": "keeper_entry_ttl_ledgers_min{network=\"$network\"} / 17280",
          "datasource": {
            "type": "prometheus",
            "uid": "cfgw0aa7mups0d"
          },
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "contract": "Contract",
              "group": "Key group",
              "Value": "Headroom"
            },
            "indexByName": {
              "contract": 0,
              "group": 1,
              "Value": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Headroom"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "right",
            "filterable": true
          },
          "unit": "d",
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Contract|Key group"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Headroom"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 21
                    },
                    {
                      "color": "green",
                      "value": 45
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Entries by state \u2014 a group that is entirely never_created can be a broken key",
      "description": "Live, expired (TTL lapsed or archived, restorable) and never_created (the RPC returned no entry). The RPC returns an archived or evicted entry with its value and live-until 0, so it reads as expired. A group that is entirely never_created is a key nothing wrote yet or a wrong key encoding; every other metric reads 'nothing to do' in both cases. Any expired row is storage the keeper did not extend in time.",
      "datasource": {
        "type": "prometheus",
        "uid": "cfgw0aa7mups0d"
      },
      "gridPos": {
        "x": 14,
        "y": 7,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "refId": "E",
          "expr": "keeper_entries{network=\"$network\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "cfgw0aa7mups0d"
          },
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "contract": "Contract",
              "group": "Key group",
              "state": "State",
              "Value": "Entries"
            },
            "indexByName": {
              "contract": 0,
              "group": 1,
              "state": 2,
              "Value": 3
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "all",
            "filters": [
              {
                "fieldName": "Entries",
                "config": {
                  "id": "equal",
                  "options": {
                    "value": 0
                  }
                }
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "right",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "Contract|Key group|State"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "TTL headroom over time",
      "description": "Each series is one contract/key group. A downward slope that crosses the safety margin is when the keeper starts extending.",
      "datasource": {
        "type": "prometheus",
        "uid": "cfgw0aa7mups0d"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "TTL",
          "expr": "keeper_entry_ttl_ledgers_min{network=\"$network\"} / 17280",
          "datasource": {
            "type": "prometheus",
            "uid": "cfgw0aa7mups0d"
          },
          "format": "time_series",
          "legendFormat": "{{contract}} / {{group}}"
        },
        {
          "refId": "MARGIN",
          "expr": "keeper_safety_margin_ledgers{network=\"$network\"} / 17280",
          "datasource": {
            "type": "prometheus",
            "uid": "cfgw0aa7mups0d"
          },
          "format": "time_series",
          "legendFormat": "safety margin"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "safety margin"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "min"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Simulated resource fee per job kind (rent cost)",
      "description": "Resource fee, in stroops, that simulation returned for the last job of each kind. Measured from the network, not modelled from entry size, and before resource_fee_multiplier. A dry-run keeper sets it for every simulation that passes; a submitting keeper sets it for every transaction that succeeds.",
      "datasource": {
        "type": "prometheus",
        "uid": "cfgw0aa7mups0d"
      },
      "gridPos": {
        "x": 14,
        "y": 17,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "FEE",
          "expr": "keeper_sim_resource_fee_stroops{network=\"$network\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "cfgw0aa7mups0d"
          },
          "format": "time_series",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Keeper activity",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
