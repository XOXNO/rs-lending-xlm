        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "network",
        "label": "Network",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "cfgw0aa7mups0d"
        },
        "query": {
          "query": "label_values(keeper_current_ledger, network)",
          "refId": "network"
